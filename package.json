{
  "name": "afterimage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AFTERIMAGE — Non-horror interactive memory essay driven by gaze, blinks, and breath via Presage SmartSpectra SDK.",
  "scripts": {
    "cameras": "node spike/camera-spike.mjs --list",
    "spike": "node spike/camera-spike.mjs",
    "bridge": "node bridge/server.mjs",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node bridge/server.mjs",
    "test": "node --test bridge/signal-processor.test.mjs",
    "verify-trace": "node scripts/verify-trace.mjs",
    "check": "npm test && npm run verify-trace && npm run build"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0",
    "ws": "^8.18.0"
  }
}
